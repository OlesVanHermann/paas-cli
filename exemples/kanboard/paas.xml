<?xml version="1.0" encoding="UTF-8"?>
<!-- Exemple di2amp : kanboard. Dérivé du fichier en service sur la plateforme di2amp (dépôt de preuve, commit 828deec63cf4, 2026-10-05), planifié sans erreur sur le même arbre le 2026-10-10.
     Avant usage : lire README.md ; sceller vos propres secrets (chaque valeur A-SCELLER, commande paas secrets seal) ;
     commiter, vérifier par paas config plan (avec l'instantané du catalogue), pousser l'arbre amont exact avec ce fichier. Documentation : ../docs/ -->
<paas>
  <!-- Sources GitHub Kanboard v1.2.54, commit 9ce6a5edc.
       Le seul ajout au contenu amont est ce fichier XML. -->
  <paas_spec_version>v2.9.2</paas_spec_version>
  <app><name>kanboard</name><version>1.2.54</version></app>
  <build>
    <runtime>php</runtime><runtime_version>8.4.26</runtime_version>
    <recipe>php-8.4.26-apache-alpine-sqlite-intl-v4</recipe><catalogue>2026.10.04.php.20</catalogue>
    <!-- Le Dockerfile amont reste dans Git ; la recette PHP publiée est le contrat de build. -->
    <source_dockerfile>ac3fc80b74e58265a21d89ff713c73cd66a9bb10a6dd49fc9c436939691c6d9b</source_dockerfile>
    <php>
      <extensions><item>ctype</item><item>gmp</item><item>intl</item><item>opcache</item><item>pcntl</item>
        <item>pdo_mysql</item><item>pdo_sqlite</item><item>simplexml</item><item>tokenizer</item><item>xmlreader</item></extensions>
      <dependency_mode>composer-locked-git-v2</dependency_mode>
      <vendor_policy>production-packages-only</vendor_policy>
      <ini><memory_limit>256M</memory_limit><upload_max_filesize>16M</upload_max_filesize><post_max_size>18M</post_max_size></ini>
    </php>
    <test><command>php -l index.php &amp;&amp; php -l healthcheck.php</command></test>
  </build>
  <processes><item><name>web</name><type>web</type><replicas>1</replicas><argv><item>httpd</item><item>-DFOREGROUND</item></argv><port>8080</port></item></processes>
  <resources><cpu>1</cpu><memory>512Mi</memory></resources>
  <healthcheck><path>/healthcheck.php</path><port>8080</port></healthcheck>
  <web><https>true</https><deny><item>data</item><item>app</item><item>libs</item><item>vendor</item><item>tests</item><item>cli</item><item>config.default.php</item></deny></web>
  <storage>
    <volumes><item><name>state</name><mount>/data</mount><size>2Gi</size><access>rwo</access><class>local-path</class><preserve_on_delete>true</preserve_on_delete><processes><item>web</item></processes></item></volumes>
    <links><item><path>/app/data</path><target>/data/data</target></item></links>
    <seeds><item><from>/app/data</from><to>/data/data</to><policy>absent-only</policy></item></seeds>
  </storage>
  <env><LOG_DRIVER>stderr</LOG_DRIVER></env>
  <lifecycle><lock>true</lock><interrupted>resume</interrupted><state_directory>/data/lifecycle</state_directory>
    <!-- Migrations natives à chaque démarrage : schéma SQLite et compte « admin » initial de Kanboard. -->
    <prepare><argv><item>php</item><item>cli</item><item>db:migrate</item></argv><timeout_seconds>600</timeout_seconds></prepare>
    <upgrade><argv><item>php</item><item>cli</item><item>db:migrate</item></argv><timeout_seconds>600</timeout_seconds></upgrade>
    <!-- Formulaires natifs : le mot de passe initial documenté de Kanboard est remplacé par le secret du compte. -->
    <install_http><timeout_seconds>180</timeout_seconds><steps>
      <item><method>POST</method><path>/index.php?controller=AuthController&amp;action=login</path>
        <form><username>{{account.username}}</username><password>{{secrets.KANBOARD_INITIAL_PASSWORD}}</password></form></item>
      <item><method>POST</method><path>/index.php?controller=UserCredentialController&amp;action=changePassword&amp;user_id=1</path>
        <form><current_password>{{secrets.KANBOARD_INITIAL_PASSWORD}}</current_password><password>{{account.password}}</password><confirmation>{{account.password}}</confirmation></form></item>
      <item><method>POST</method><path>/index.php?controller=UserModificationController&amp;action=show&amp;user_id=1</path>
        <form><username>{{account.username}}</username><name>{{account.title}}</name><email>{{account.email}}</email><role>app-admin</role></form></item>
    </steps></install_http>
    <file_checks>
      <item><phase>ready</phase><path>/data/data/db.sqlite</path><contains>{{account.username}}</contains></item>
      <item><phase>ready</phase><path>/data/data/db.sqlite</path><contains>{{account.email}}</contains></item>
      <item><phase>before-upgrade</phase><path>/data/data/db.sqlite</path><contains>{{account.email}}</contains></item>
    </file_checks>
  </lifecycle>
  <account><username>admin</username><email>administrator@example.invalid</email><title>Kanboard PaaS XML</title>
    <constraints><password_min>32</password_min><password_max>64</password_max></constraints>
  </account>
  <!-- Compte de test paasadmin : mot de passe scellé pour la plateforme, créé par le formulaire natif d'administration. -->
  <accounts><item><username>paasadmin</username><email>paasadmin@example.com</email><title>paasadmin</title>
    <password_secret>PAASADMIN_PASSWORD</password_secret>
    <http><timeout_seconds>120</timeout_seconds><steps>
      <item><method>POST</method><path>/index.php?controller=AuthController&amp;action=login</path>
        <form><username>{{account.username}}</username><password>{{account.password}}</password></form></item>
      <item><method>POST</method><path>/index.php?controller=UserCreationController&amp;action=show</path>
        <form><username>{{user.username}}</username><name>{{user.title}}</name><email>{{user.email}}</email>
          <password>{{user.password}}</password><confirmation>{{user.password}}</confirmation><role>app-admin</role></form></item>
    </steps></http>
  </item></accounts>
  <!-- Mot de passe initial documenté de Kanboard (« admin »), remplacé à l'installation. -->
  <secrets><KANBOARD_INITIAL_PASSWORD><sealed>A-SCELLER</sealed><rotate>never</rotate></KANBOARD_INITIAL_PASSWORD>
    <PAASADMIN_PASSWORD><sealed>A-SCELLER</sealed><rotate>never</rotate></PAASADMIN_PASSWORD></secrets>
</paas>
